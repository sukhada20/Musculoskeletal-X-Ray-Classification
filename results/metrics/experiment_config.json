  "ARCH_CFG": {
    "densenet121": {
      "lr_head_s1": 0.001,
      "lr_head_s2": 0.0001,
      "lr_backbone_s2": 1e-05
    },
    "resnet50": {
      "lr_head_s1": 0.001,
      "lr_head_s2": 0.0001,
      "lr_backbone_s2": 1e-05
    },
    "efficientnet_b0": {
      "lr_head_s1": 0.001,
      "lr_head_s2": 0.0002,
      "lr_backbone_s2": 2e-05
    }
  }
